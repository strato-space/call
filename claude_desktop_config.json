{
  "mcpServers": {
    "fs": {
      "command": "npx",
      "args": [
        "-y",
        "@modelcontextprotocol/server-filesystem",
        "D:/home/strato-space"
      ],
      "env": {}
    },
    "seq": {
      "command": "npx",
      "args": [
        "-y",
        "@modelcontextprotocol/server-sequential-thinking"
      ],
      "env": {}
    },
    "telegram-mcp": {
      "command": "uv",
      "args": [
        "--directory",
        "D:/home/strato-space/telegram-mcp",
        "run",
        "main.py"
      ]
    },
    "voice": {
      "command": "uv",
      "args": [
        "--directory",
        "D:/home/strato-space/voice",
        "run",
        "-m",
        "mcp_voicebot.server"
      ]
    },
    "gsh": {
      "command": "uvx",
      "args": [
        "--env-file",
        "/home/strato-space/call/.env",
        "--from",
        "git+https://github.com/strato-space/mcp-google-sheets@main",
        "mcp-google-sheets"
      ],
      "env": {}
    }
  },
  "isDxtAutoUpdatesEnabled": true
}
