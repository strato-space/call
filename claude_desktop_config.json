{
  "isUsingBuiltInNodeForMcp": false,
  "isDxtAutoUpdatesEnabled": true,
  "mcpServers": {
    "fs": {
      "command": "npx",
      "args": [
        "-y",
        "@modelcontextprotocol/server-filesystem",
        "C:/home/strato-space"
      ],
      "env": {}
      },
      "seq": {
      "command": "npx",
      "args": ["-y", "@modelcontextprotocol/server-sequential-thinking"],
      "env": {}
     },
    "tg-ro": {
      "command": "uv",
      "args": [
        "--directory",
        "/home/strato-space/telegram-mcp-ro",
        "run",
        "voice.py"
      ]
    },
    "tg-rw": {
      "command": "uv",
      "args": [
        "--directory",
        "/home/strato-space/telegram-mcp",
        "run",
        "main.py"
      ]
    },
     "tgbot": {
      "command": "uv",
      "args": [
        "--directory",
        "/home/strato-space/mcp-telegram-bot",
        "run",
        "mcp-telegram-bot",
        "start"
      ]
    },
    "voice": {
      "command": "uv",
      "args": [
        "--directory",
        "c:/home/strato-space/voice",
        "run",
        "-m",
        "mcp_voicebot.server"
      ]
    },
    "call": {
      "command": "C:/home/strato-space/.venv/Scripts/python.exe",
      "args": [
        "-m",
        "call.mcp.server"
      ],
      "env": {
        "PYTHONPATH": "C:/home/strato-space"
      }
    }
  }
}