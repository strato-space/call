{
  "mcpServers": {
    "fs-local": {
      "command": "npx",
      "args": [
        "-y",
        "@modelcontextprotocol/server-filesystem",
        "D:/home/strato-space"
      ],
      "env": {}
    },
    "seq-local": {
      "command": "npx",
      "args": [
        "-y",
        "@modelcontextprotocol/server-sequential-thinking"
      ],
      "env": {}
    },
    "telegram-mcp": {
      "command": "uv",
      "args": [
        "--env-file",
        "D:/home/strato-space/call/.env",
        "--directory",
        "D:/home/strato-space/telegram-mcp",
        "run",
        "main.py"
      ]
    },
    "voice": {
      "command": "uvx",
      "args": [
        "--env-file",
        "D:/home/strato-space/call/.env",
        "--from",
        "git+https://github.com/strato-space/voice@main",
        "mcp-voicebot"
      ]
    }
  },
  "isDxtAutoUpdatesEnabled": true
}
