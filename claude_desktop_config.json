{
  "mcpServers": {
    "fs-local": {
      "command": "npx",
      "args": [
        "-y",
        "@modelcontextprotocol/server-filesystem",
        "D:/home/strato-space"
      ],
      "env": {}
    },
    "seq-local": {
      "command": "npx",
      "args": [
        "-y",
        "@modelcontextprotocol/server-sequential-thinking"
      ],
      "env": {}
    },
    "telegram-mcp": {
      "command": "uv",
      "args": [
        "--directory",
        "D:/home/strato-space/telegram-mcp",
        "run",
        "main.py"
      ]
    },
    "voice": {
      "command": "uv",
      "args": [
        "--directory",
        "D:/home/strato-space/voice",
        "run",
        "-m",
        "mcp_voicebot.server"
      ]
    }
  },
  "isDxtAutoUpdatesEnabled": true
}
