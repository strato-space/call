# Normalize text files automatically
* text=auto

# Shell scripts must use LF (required on Linux/WSL)
*.sh text eol=lf
*.bash text eol=lf

# Keep Windows-native scripts CRLF
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf

# Common text files
*.py text eol=lf
*.md text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.json text eol=lf
*.toml text eol=lf
*.ini text eol=lf
