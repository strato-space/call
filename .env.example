# Environment for call subsystem (library/pipeline)
# Copy to .env and fill values. Do NOT commit secrets.

# Telegram bot and publishing defaults
# Token for python-telegram-bot Application
TELEGRAM_TOKEN=
# Allow-list of Telegram user IDs (comma-separated). Optional.
ALLOWED_USERS=
# Control whether to drop pending updates on startup (false keeps backlog)
DROP_PENDING_UPDATES=false
# Defaults used by call pipeline utilities
TELEGRAM_DEBUG_CHAT_ID=
TELEGRAM_DEBUG_THREAD_ID=

# Reply behavior: when replying to a message id, allow sending even if the message is gone.
# Applies when python-telegram-bot ReplyParameters are available.
TG_ALLOW_SENDING_WITHOUT_REPLY=1

# Telegraph token for publishing long outputs (used by lib via app utils)
TELEGRAPH_TOKEN=

# OpenAI API key (used by lib/pipeline)
OPENAI_API_KEY=

# Optional prompt repository override. If unset, discovery will search common paths.
PROMPT_REPO=

# MCP configuration (new names)
# MCP_CONFIG_PATH points to mcp_config.yaml, ENABLE_MCP toggles MCP servers on startup
MCP_CONFIG_PATH=call/mcp_config.yaml
ENABLE_MCP=false
