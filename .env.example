# Environment for call subsystem (library/pipeline)
# Copy to .env and fill values. Do NOT commit secrets.

# Core API keys
OPENAI_API_KEY=

# Model defaults
LLM_MODEL=gpt-5
AGENTS_DEFAULT_MAX_TURNS=150

# Repository paths
AGENT_REPO=
PROMPT_REPO=
repos=agent,prompt
# Absolute paths are also accepted; repo kind is auto-detected and mapped to
# AGENT_REPO/PROMPT_REPO automatically.
# repos=/home/strato-space/agent,/home/strato-space/prompt

# Database paths
CALL_DB=.cache/call/call.db
DB_PATH=.cache/call/repo.db
EVENT_DB_PATH=.cache/call/events.db

# MCP configuration
MCP_CONFIG_PATH=call/mcp_config.yaml
ENABLE_MCP=false

# Actions API auth
API_ACCESS_TOKEN=
CALL_ACTIONS_TOKEN=

# Telegram bot and publishing defaults
TELEGRAM_TOKEN=
ALLOWED_USERS=
DROP_PENDING_UPDATES=false
TELEGRAM_DEBUG_CHAT_ID=
TELEGRAM_DEBUG_THREAD_ID=
TELEGRAM_BOT_TOKEN=
TELEGRAM_LIVE=
TELEGRAM_LIVE_KIND=skip
TELEGRAM_LOG_EMPTY_UPDATES=0
TELEGRAM_PHOTO_VARIANT=largest
TELEGRAM_API_ID=
TELEGRAM_API_HASH=
TG_ALLOW_SENDING_WITHOUT_REPLY=1
TG_CLEANUP_MCP_MESSAGES=0
CALL_INCLUDE_TELEGRAM_MESSAGE=0
CALL_INCLUDE_TELEGRAM_BOT=0

# Per-project Telegram tokens (optional)
TELEGRAM_TOKEN__MyProject=

# Bot behavior overrides (optional)
BOT_SHOW_COST_TOTALS__MediaGenBlender=0
TG_FILTER_FETCH_IMAGES__MediaGenBlender=0
TG_FILTER_FETCH_IMAGES__MediaGenMeme=0

# Telegraph token for publishing long outputs
TELEGRAPH_TOKEN=

# Logging & debugging
CALL_DEBUG=0
CALL_DEBUG_YAML=0
CALL_DEBUG_TELEGRAM=0
CALL_LOG_FILE=
CALL_LOG_JSON=0
CALL_LOG_SANITIZE_IMAGES=0
OTEL_SDK_DISABLED=1

# Google Workspace integrations
GOOGLE_SERVICE_ACCOUNT_KEY=
GOOGLE_APPLICATION_CREDENTIALS=
DRIVE_FOLDER_ID=
PROMPT_REPO_SHEET_ID=
PROMPT_TEST_REPO_SHEET_ID=

# GitHub integration
GITHUB_REMOTE_ORGANIZATION_URL=
GITHUB_BRANCH=main
GITHUB_TOKEN_PROMPT=
GITHUB_TOKEN_PROMPT_TEST=
GITHUB_TOKEN_VM=
GITHUB_PAT=



# Misc runtime tuning
NO_PROXY=
HOST=
WORKDIR=
METHOD=
MEMORY_FILE_PATH=
TS_LANG=
